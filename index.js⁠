// 1. Parsing dinâmico da lista
const parsed = iptvParser.parse(m3uRaw);

const channels = parsed.items.map((item, index) => {
    const group = item.group.title || 'Geral';
    return {
        id: `m3u_ch_${index}`,
        name: item.name || 'Canal Sem Nome',
        logo: item.tvg.logo || 'https://via.placeholder.com/150',
        group: group,
        url: item.url
    };
});

// Grupos únicos para os filtros de categoria no Stremio
const genresList = [...new Set(channels.map(ch => ch.group))];

// 2. Manifest do Addon
const builder = new addonBuilder({
    id: 'org.m3u.custom.list',
    version: '1.0.0',
    name: 'M3U Live IPTV',
    description: 'Addon gerado dinamicamente a partir de lista M3U',
    resources: ['catalog', 'meta', 'stream'],
    types: ['tv'],
    catalogs: [
        {
            type: 'tv',
            id: 'm3u_catalog',
            name: 'Canais M3U',
            extra: [{ name: 'genre', options: genresList, isRequired: false }]
        }
    ]
});

// 3. Catálogo com Categorias
builder.defineCatalogHandler(({ extra }) => {
    let filtered = channels;
    if (extra && extra.genre) {
        filtered = channels.filter(ch => ch.group === extra.genre);
    }

    const metas = filtered.map(ch => ({
        id: ch.id,
        type: 'tv',
        name: ch.name,
        poster: ch.logo,
        genres: [ch.group]
    }));

    return Promise.resolve({ metas });
});

// 4. Detalhes do Canal
builder.defineMetaHandler(({ id }) => {
    const channel = channels.find(ch => ch.id === id);
    if (!channel) return Promise.resolve({ meta: null });

    return Promise.resolve({
        meta: {
            id: channel.id,
            type: 'tv',
            name: channel.name,
            poster: channel.logo,
            genres: [channel.group],
            description: `Transmissão ao vivo de ${channel.name}`
        }
    });
});

// 5. Streams Direct URL
builder.defineStreamHandler(({ id }) => {
    const channel = channels.find(ch => ch.id === id);
    if (!channel) return Promise.resolve({ streams: [] });

    return Promise.resolve({
        streams: [
            {
                title: 'Assistir Ao Vivo',
                url: channel.url
            }
        ]
    });
});

// 6. Inicialização do Servidor HTTP
const PORT = process.env.PORT || 7000;
serveHTTP(builder.getInterface(), { port: PORT });
console.log(`Addon rodando na porta ${PORT}`);
